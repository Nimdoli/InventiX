<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows plain HTTP only to the Android emulator's alias for the host
         machine's localhost, where the local FastAPI dev server runs.
         Everything else (Supabase, etc.) still requires HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
